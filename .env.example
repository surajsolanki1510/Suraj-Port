# Firebase Firestore global leaderboard (optional)
# 1. Create a free project at https://console.firebase.google.com
# 2. Build -> Firestore Database -> Create database (Production mode)
# 3. Paste the rules from firestore.rules into the Rules tab -> Publish
# 4. Project settings -> General -> "Web API Key" and "Project ID"
# 5. Copy this file to .env.local and fill in your values
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_API_KEY=your-web-api-key
